#!/usr/bin/env bash
zero="0000000000000000000000000000000000000000"
_skip_full=true
while read -r _local_ref _local_oid _remote_ref _remote_oid; do
  if [ "$_remote_oid" = "$zero" ] || [ "$_local_oid" = "$zero" ]; then
    _skip_full=false
    continue
  fi
  _changed="$(git diff --name-only "$_remote_oid" "$_local_oid" 2>/dev/null || true)"
  if [ -n "$_changed" ] && printf '%s\n' "$_changed" | grep -qvE '^(CLAUDE\.md|\.githooks/.*)$'; then
    _skip_full=false
  fi
done
if [ "$_skip_full" = true ]; then
  exit 0
fi
# Pre-push: run tests, verify the Pages build, optionally run smoke.
# Skip the smoke leg with SKIP_SMOKE=1 (default off — set to 1 if you don't have
# Docker available locally; CI-style verification happens via `make smoke`).

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }

bold "→ make test"
make test

bold "→ make build (verifying docs/ is Pages-ready)"
make build
[[ -f docs/index.html ]] || { echo "docs/index.html missing after build"; exit 1; }
grep -q '<div id="root">' docs/index.html || { echo "docs/index.html is malformed"; exit 1; }

if [[ "${SKIP_SMOKE:-0}" != "1" ]]; then
  if command -v docker >/dev/null && docker info >/dev/null 2>&1; then
    bold "→ make smoke"
    make smoke
  else
    echo "  (docker not available — skipping smoke; set SKIP_SMOKE=1 to silence)"
  fi
fi
