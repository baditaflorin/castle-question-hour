# --- Public Pages frontend origin (allowed by CORS) ---
PAGES_ORIGIN=https://baditaflorin.github.io

# --- Backend HTTP listener (internal only, behind nginx) ---
SERVER_ADDR=:8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=30s

# --- Storage ---
# leave empty for in-memory only; set to a path to enable SQLite persistence
SQLITE_PATH=

# --- Ollama (local LLM) ---
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=60s

# --- Piper (local TTS) ---
# either a path to the piper binary OR an http URL to a piper-http wrapper
PIPER_BIN=/usr/local/bin/piper
PIPER_VOICE=/voices/en_US-lessac-medium.onnx
# alternative: PIPER_HTTP_URL=http://piper:5000

# --- Web Push (VAPID) ---
# generate with: go run ./cmd/vapid-keygen
VAPID_PUBLIC_KEY=REPLACE_ME_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_ME_PRIVATE_KEY
VAPID_SUBJECT=mailto:steward@example.org

# --- Hourly schedule ---
HOURLY_ENABLED=true
HOURLY_CRON=0 * * * *
QUESTIONS_FILE=/etc/cqh/questions.json

# --- Observability ---
LOG_LEVEL=info
METRICS_ENABLED=true

# --- Build / runtime ---
APP_VERSION=dev
